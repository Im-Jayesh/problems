# InstantDB Configuration
# Public App ID used by both client and server
NEXT_PUBLIC_INSTANT_APP_ID=
# Server-only Admin Token for privileged writes via @instantdb/admin
INSTANT_APP_ADMIN_TOKEN=

# Google Gemini API
GEMINI_API_KEY=
# Optional override for moderation model (defaults to gemini-2.5-flash-lite)
# GEMINI_MODERATION_MODEL=gemini-2.5-flash-lite

# Upstash Redis (rate limiting & vote deduplication; falls back to in-memory Map if omitted)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# HMAC-SHA256 signing secret for device cookies, borderline tokens, and undo tokens
# Falls back to INSTANT_APP_ADMIN_TOKEN or a dev secret if omitted
APP_SECRET=

# Optional Cloudflare Turnstile CAPTCHA
# Server-side secret key (enables Turnstile verification on suspicious/rate-limited requests)
TURNSTILE_SECRET_KEY=
# Client-side site key (renders Turnstile widget in UI when set)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
